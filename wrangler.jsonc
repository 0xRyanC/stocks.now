{
  "name": "stocks-now",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "workers_dev": false,
  "routes": [
    { "pattern": "stocks.now/*", "zone_name": "stocks.now" },
    { "pattern": "www.stocks.now/*", "zone_name": "stocks.now" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stocks-now",
      "database_id": "fbdf2182-0222-4b67-a024-923951801682",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      // Record prices every 5 minutes, day and night: the 24/7 stocks trade at
      // their token's price on Base any hour. A run with no new prices records nothing.
      "*/5 * * * *",
      // Friday results, after the US close. Day names on purpose: in Cloudflare
      // cron, 1 = Sunday, so "5" would mean Thursday.
      "20 21 * * fri"
    ]
  },
  "assets": { "directory": "./public" },
  "observability": { "enabled": true }
}
